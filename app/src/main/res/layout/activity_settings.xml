<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="200dp">


            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsHeader"
                        android:text="Library display size" />

                    <TextView
                        style="@style/SettingsHelp"
                        android:text="Size of video names and thumbnails in the library." />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/sizeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sizeSmall"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Small" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sizeMedium"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Medium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sizeLarge"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Large" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsHeader"
                        android:text="Subtitle languages" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Comma-separated codes, e.g. en,es,fr"
                        app:helperText="Searched in this order. Two-letter ISO codes.">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/languages"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsHeader"
                        android:text="OpenSubtitles.com" />

                    <TextView
                        android:id="@+id/osHelp"
                        style="@style/SettingsHelp"
                        android:text="Free API key: sign up at opensubtitles.com, then open opensubtitles.com/consumers and create a consumer. Logging in with your account is optional but raises your daily download limit." />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SettingsField"
                        android:hint="API key">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/osKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SettingsField"
                        android:hint="Username (optional)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/osUser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SettingsField"
                        android:hint="Password (optional)"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/osPass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsHeader"
                        android:text="SubDL.com" />

                    <TextView
                        style="@style/SettingsHelp"
                        android:text="Free API key: sign up at subdl.com, then copy the key from your account’s API panel." />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SettingsField"
                        android:hint="API key">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/subdlKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsHeader"
                        android:text="Playback" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/hwDecode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                    android:text="Hardware decoding (turn off if a video shows green/garbled frames)" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SettingsField"
                        android:hint="Subtitle text encoding (blank = auto)"
                        app:helperText="e.g. Windows-1250 for Central European, Windows-1256 for Arabic, CP1251 for Cyrillic">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/encoding"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SettingsField"
                        android:hint="Subtitle size (%)"
                        app:helperText="100 = default">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/subSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:minHeight="52dp"
        android:text="@string/save"
        app:cornerRadius="16dp" />
</LinearLayout>
