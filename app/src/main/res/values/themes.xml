<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ReelPlayer" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/lavender_700</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/lavender_200</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/sea_600</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/sea_200</item>
        <item name="colorTertiary">@color/meadow_600</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorOutline">@color/lavender_300</item>
        <item name="colorControlNormal">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="android:statusBarColor">@color/lavender_50</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/meadow_400</item>
        <item name="textInputStyle">@style/Field</item>
        <item name="toolbarStyle">@style/Toolbar</item>
    </style>

    <style name="Theme.ReelPlayer.Player">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
